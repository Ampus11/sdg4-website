# Salin file ini menjadi `.env.local` untuk pengembangan lokal,
# dan set variabel yang sama di Vercel → Settings → Environment Variables.
#
# Contoh value (bukan kredensial asli):
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Notifikasi email (opsional) — buat API key di https://resend.com
RESEND_API_KEY=rk_1234567890
# Email penerima notifikasi saat ada pesan baru:
NOTIF_EMAIL=lynxa4777@gmail.com
# Pengirim (harus terverifikasi di Resend; default onboarding@resend.dev
# hanya bisa mengirim ke pemilik akun Resend):
EMAIL_FROM=SDG 4 Indonesia <onboarding@resend.dev>