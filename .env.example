# Salin file ini menjadi `.env.local` untuk pengembangan lokal,
# dan set variabel yang sama di Vercel → Settings → Environment Variables.
#
# Contoh value (bukan kredensial asli):
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# --- Panel admin ---
# Password untuk masuk ke /admin (kelola materi & lihat pesan).
# Pilih kata sandi kuat yang tidak kamu pakai di tempat lain.
ADMIN_PASSWORD=ganti-dengan-password-kuat
