# Salin file ini menjadi `.env.local` untuk pengembangan lokal,
# dan set variabel yang sama di Vercel → Settings → Environment Variables.
#
# Contoh value (bukan kredensial asli):
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# --- Notifikasi email (opsional) ---
# Kirim notifikasi tiap pesan masuk via SMTP Gmail (App Password).
# Cara membuat: https://myaccount.google.com/apppasswords
#   (butuh Google 2-Step Verification aktif pada akun tsb)
SMTP_USER=lynxa4777@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
# Email penerima notifikasi:
NOTIF_EMAIL=lynxa4777@gmail.com
# Opsional (default smtp.gmail.com:465):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Panel admin ---
# Password untuk masuk ke /admin (kelola materi & lihat pesan).
# Pilih kata sandi kuat yang tidak kamu pakai di tempat lain.
ADMIN_PASSWORD=ganti-dengan-password-kuat